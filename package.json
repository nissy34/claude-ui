{
  "name": "claude-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted web UI that fronts the interactive Claude Code CLI running in persistent ptys",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node scripts/ensure-build.js && node server/index.js",
    "start:env": "node scripts/ensure-build.js && node --env-file=.env server/index.js",
    "hash-password": "node server/hash-password.js",
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/test-projects.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:resize": "node scripts/test-resize.mjs",
    "test:bridge": "node scripts/test-bridge.mjs",
    "demo:teams": "node scripts/teams-demo.mjs",
    "test:gateway": "node scripts/test-gateway.mjs",
    "test:token": "node scripts/test-oauth-token.mjs",
    "test:sessions": "node scripts/test-sessions.mjs",
    "test:git-identity": "node scripts/test-git-identity.mjs",
    "test:pr": "node scripts/test-pr-status.mjs",
    "test:pr-bar": "node scripts/test-pr-bar.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^7.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
