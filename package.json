  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^7.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "react": "^18.3.1",
