# Copy to .env (or /etc/claude-web.env for systemd) and fill in.

# Login password. Prefer a hash: npm run hash-password -- 'your password'
CW_PASSWORD_HASH=
# CW_PASSWORD=change-me

# Where your projects live. Each folder directly inside shows up in the sidebar.
# Default: ~/projects (or your home folder if that doesn't exist). With Docker,
# write a full path; docker-compose.yml mounts this folder at the same path.
# CW_PROJECTS_ROOT=/home/you/projects

# Listen address. Keep 127.0.0.1 behind a reverse proxy or Tailscale Serve;
# use 0.0.0.0 only on a trusted network (e.g. a Tailscale-only interface).
# (Ignored by docker-compose.yml, which listens on 0.0.0.0 inside the container
# and publishes CW_PORT on the host.)
CW_HOST=127.0.0.1
CW_PORT=8787

# Optional
# CW_DATA_DIR=~/.claude-web            # session list, chat logs, terminal screens, cookie secret
# CW_CLAUDE_BIN=claude                 # path to the claude CLI
# CW_CLAUDE_ARGS=                      # extra args for every claude process
# CW_CHAT_IDLE_MINUTES=30              # stop idle chat processes after this long (0 = never); they resume on the next message
# CW_CHILD_SESSIONS=1                 # 0 = don't give chats the start/send/read session tools
# CW_DESKTOP_MCP=1                    # 0 = no Claude Desktop handoff server (/mcp) or shared notes
# CW_PUBLIC_URL=                     # address other computers use, e.g. http://myserver:8787 (for the Claude Desktop setup snippets; set it in Docker)
# CW_MCP_TOKEN=                       # fixed bearer token for /mcp (default: generated, see Settings)
# CW_BROWSER=1                        # 0 = no built-in browser
# CW_BROWSER_PATH=                    # Chrome/Chromium/Edge binary for the built-in browser
# CW_ALLOW_ANY_DIR=0                   # 1 = allow sessions outside CW_PROJECTS_ROOT
# CW_SCRATCH_DIR=~/.claude-web/scratch  # where "No folder" chats run
# CW_COOKIE_SECURE=                    # true/false; default: auto-detect HTTPS
# CW_TRUST_PROXY=0                     # 1 when behind a reverse proxy on the same host/LAN
# CW_SESSION_DAYS=30                   # how long a login lasts

# Teams bridge (optional, teams-bridge/README.md): talk to your agents from Microsoft Teams.
# CW_BRIDGE_API=1                      # 0 = turn off the /api/bridge attention feed the bridge uses
# CW_BRIDGE_TOKEN=                     # fixed token for /api/bridge (default: generated in ~/.claude-web/bridge-token)
# TEAMS_TENANT_ID=                     # your Entra tenant id (or domain)
# TEAMS_CLIENT_ID=                     # app registration with delegated Chat.ReadWrite, public client flows on
# TEAMS_CHAT_ID=48:notes               # the chat to use; 48:notes = your chat with yourself
# TEAMS_DEFAULT_PROJECT=               # project that gets plain messages (default: the only project, if one)
# TEAMS_AWAY_MINUTES=5                 # hold questions while you used the web UI in the last N minutes (0 = always send)
# TEAMS_ALLOW_PERMISSIONS=1            # 0 = Teams can answer questions and decisions but not approve tools
# TEAMS_POLL_SECONDS=5                 # how often to check the Teams chat
# TEAMS_PING_URL=                      # optional Teams Workflows webhook for phone notifications (see the README)
